# Copie para .env.local e preencha com os dados do seu projeto Supabase
# Painel > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key

# Somente servidor — usada em /api/team para criar/remover usuários da equipe.
# Nunca exponha esta chave no cliente.
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key
